{
  "name": "labzefry/oneqay-foundation",
  "description": "Framework-agnostic Authentication, Tenant Context, Authorization, Configuration, Bootstrap, and Runtime Capability foundations for OneQay Technical Preview.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "files": [
      "src/Auth/Foundation.php",
      "src/Tenant/Foundation.php",
      "src/Authorization/Foundation.php",
      "src/Configuration/Foundation.php",
      "src/Runtime/Foundation.php"
    ],
    "psr-4": {
      "OneQay\\Http\\": "src/Http/"
    }
  },
  "scripts": {
    "test": [
      "php tests/run.php",
      "php tests/runtime.php"
    ]
  }
}
