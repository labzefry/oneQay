{
  "name": "labzefry/oneqay-foundation",
  "description": "Framework-agnostic Authentication, Tenant Context, Authorization, Configuration, Runtime, Persistence, Migration Governance, Data Definition, Tenant Isolation, Physical Mapping, Vendor Compatibility, and Physical Schema Planning foundations for OneQay Technical Preview.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "files": [
      "src/Auth/Foundation.php",
      "src/Tenant/Foundation.php",
      "src/Authorization/Foundation.php",
      "src/Configuration/Foundation.php",
      "src/Runtime/Foundation.php",
      "src/Runtime/Qualification.php",
      "src/Persistence/Foundation.php",
      "src/Migration/Foundation.php",
      "src/DataDefinition/Foundation.php",
      "src/PhysicalMapping/Foundation.php",
      "src/SchemaPlanning/Foundation.php"
    ],
    "psr-4": {
      "OneQay\\Http\\": "src/Http/"
    }
  },
  "scripts": {
    "test": [
      "php tests/run.php",
      "php tests/runtime.php",
      "php tests/runtime-qualification.php",
      "php tests/runtime-evidence-p1.php",
      "php tests/persistence.php",
      "php tests/migration.php",
      "php tests/data-definition.php",
      "php tests/physical-mapping.php",
      "php tests/schema-planning.php"
    ]
  }
}
