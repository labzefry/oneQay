{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "labzefry/oneqay-web",
  "description": "Bounded oneQay M7.1 first-party Web/PWA application skeleton.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "inertiajs/inertia-laravel": "3.3.1",
    "laravel/framework": "12.64.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "php tests/run.php && php tests/preview-database-qualification.php"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
