APP_NAME=oneQay
APP_ENV=local
APP_KEY=base64:REPLACE_WITH_A_LOCAL_OR_TEST_KEY
APP_DEBUG=false
APP_URL=http://localhost

ONEQAY_RUNTIME_CLASS=local
ONEQAY_TECHNICAL_PREVIEW_ENABLED=false

SESSION_DRIVER=array
CACHE_STORE=array
LOG_CHANNEL=stderr
LOG_LEVEL=warning
ONEQAY_OBSERVABILITY_LOG_LEVEL=info
ONEQAY_OBSERVABILITY_LOG_DAYS=14

# Technical Preview relational qualification only. Never commit real credentials.
ONEQAY_PREVIEW_DB_QUALIFICATION_ENABLED=false
ONEQAY_PREVIEW_DB_PROFILE=mariadb
ONEQAY_PREVIEW_DB_HOST=localhost
ONEQAY_PREVIEW_DB_PORT=3306
ONEQAY_PREVIEW_DB_DATABASE=REPLACE_WITH_PREVIEW_DATABASE
ONEQAY_PREVIEW_DB_USERNAME=REPLACE_WITH_PREVIEW_USER
ONEQAY_PREVIEW_DB_PASSWORD=REPLACE_WITH_PREVIEW_PASSWORD
ONEQAY_PREVIEW_DB_CHARSET=utf8mb4

