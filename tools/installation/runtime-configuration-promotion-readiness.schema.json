{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oneqay.runtime-configuration-promotion-readiness.v1",
  "title": "oneQay Runtime Configuration Promotion Execution Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "readiness_state",
    "release_id",
    "request_id",
    "authority_id",
    "qualification_fingerprint",
    "pending_environment_sha256",
    "activation_readiness_sha256",
    "promotion_request_sha256",
    "promotion_authority_sha256",
    "qualified_at_unix",
    "authority_expires_at_unix",
    "execution_contract",
    "promotion_executed",
    "migration_execution_authorized",
    "technical_preview_authorized",
    "production_authorized",
    "updater_authorized",
    "deployment_authorized",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "oneQay" },
    "readiness_state": { "const": "PROMOTION_EXECUTION_READY_NOT_EXECUTED" },
    "release_id": { "type": "string", "pattern": "^m75-preview-[0-9a-f]{12}$" },
    "request_id": { "type": "string", "pattern": "^promotion-request-[0-9a-f]{24}$" },
    "authority_id": { "type": "string", "pattern": "^promotion-authority-[0-9a-f]{24}$" },
    "qualification_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pending_environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "activation_readiness_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotion_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotion_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "qualified_at_unix": { "type": "integer", "minimum": 1 },
    "authority_expires_at_unix": { "type": "integer", "minimum": 1 },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_relative_path",
        "target_relative_path",
        "preserve_configuration_bytes_exactly",
        "active_environment_must_be_absent",
        "fresh_authority_required",
        "consume_authority_on_success",
        "consume_readiness_on_success",
        "rollback_on_post_promotion_validation_failure"
      ],
      "properties": {
        "source_relative_path": { "const": "oneqay-preview/shared/runtime/.env.pending" },
        "target_relative_path": { "const": "oneqay-preview/shared/runtime/.env" },
        "preserve_configuration_bytes_exactly": { "const": true },
        "active_environment_must_be_absent": { "const": true },
        "fresh_authority_required": { "const": true },
        "consume_authority_on_success": { "const": true },
        "consume_readiness_on_success": { "const": true },
        "rollback_on_post_promotion_validation_failure": { "const": true }
      }
    },
    "promotion_executed": { "const": false },
    "migration_execution_authorized": { "const": false },
    "technical_preview_authorized": { "const": false },
    "production_authorized": { "const": false },
    "updater_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "attribution": { "const": "Lab | zefry" }
  }
}
