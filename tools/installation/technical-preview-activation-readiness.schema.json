{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oneqay.technical-preview-activation-readiness.v1",
  "title": "oneQay Technical Preview Activation Execution Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "readiness_state",
    "release_id",
    "request_id",
    "authority_id",
    "qualification_fingerprint",
    "active_environment_sha256",
    "installation_completion_sha256",
    "activation_request_sha256",
    "activation_authority_sha256",
    "qualified_at_unix",
    "authority_expires_at_unix",
    "execution_contract",
    "authority_qualified",
    "activation_executed",
    "persistence_authorized",
    "migration_execution_authorized",
    "production_authorized",
    "updater_authorized",
    "deployment_authorized",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "oneQay" },
    "readiness_state": {
      "const": "TECHNICAL_PREVIEW_ACTIVATION_EXECUTION_READY_NOT_EXECUTED"
    },
    "release_id": {
      "type": "string",
      "pattern": "^m75-preview-[0-9a-f]{12}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^technical-preview-activation-request-[0-9a-f]{24}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^technical-preview-authority-[0-9a-f]{24}$"
    },
    "qualification_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "active_environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installation_completion_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activation_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activation_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualified_at_unix": { "type": "integer", "minimum": 1 },
    "authority_expires_at_unix": { "type": "integer", "minimum": 1 },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_environment_preflight_required",
        "https_required",
        "single_instance_required",
        "private_file_session_directory_required",
        "runtime_envelope_revalidation_required",
        "preview_off_switch_verification_required",
        "post_activation_health_check_required",
        "rollback_recovery_required",
        "migration_execution_required",
        "synthetic_data_only",
        "production_data_forbidden",
        "consume_authority_on_success",
        "consume_readiness_on_success"
      ],
      "properties": {
        "target_environment_preflight_required": { "const": true },
        "https_required": { "const": true },
        "single_instance_required": { "const": true },
        "private_file_session_directory_required": { "const": true },
        "runtime_envelope_revalidation_required": { "const": true },
        "preview_off_switch_verification_required": { "const": true },
        "post_activation_health_check_required": { "const": true },
        "rollback_recovery_required": { "const": true },
        "migration_execution_required": { "const": false },
        "synthetic_data_only": { "const": true },
        "production_data_forbidden": { "const": true },
        "consume_authority_on_success": { "const": true },
        "consume_readiness_on_success": { "const": true }
      }
    },
    "authority_qualified": { "const": true },
    "activation_executed": { "const": false },
    "persistence_authorized": { "const": false },
    "migration_execution_authorized": { "const": false },
    "production_authorized": { "const": false },
    "updater_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "attribution": { "const": "Lab | zefry" }
  }
}
