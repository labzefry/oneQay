{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oneqay.runtime-configuration-promotion-execution.v1",
  "title": "oneQay Runtime Configuration Promotion Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "execution_state",
    "release_id",
    "request_id",
    "authority_id",
    "qualification_fingerprint",
    "pending_environment_sha256",
    "activation_readiness_sha256",
    "promotion_request_sha256",
    "promotion_authority_sha256",
    "promotion_readiness_sha256",
    "active_environment_sha256",
    "executed_at_unix",
    "authority_consumption_state",
    "readiness_consumption_state",
    "pending_environment_state",
    "migration_execution_authorized",
    "technical_preview_authorized",
    "production_authorized",
    "updater_authorized",
    "deployment_authorized",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "oneQay" },
    "execution_state": { "const": "RUNTIME_CONFIGURATION_PROMOTED_NOT_ACTIVATED" },
    "release_id": { "type": "string", "pattern": "^m75-preview-[0-9a-f]{12}$" },
    "request_id": { "type": "string", "pattern": "^promotion-request-[0-9a-f]{24}$" },
    "authority_id": { "type": "string", "pattern": "^promotion-authority-[0-9a-f]{24}$" },
    "qualification_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pending_environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "activation_readiness_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotion_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotion_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotion_readiness_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "active_environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executed_at_unix": { "type": "integer", "minimum": 1 },
    "authority_consumption_state": { "const": "CONSUMED_BY_EXECUTION_RECEIPT" },
    "readiness_consumption_state": { "const": "CONSUMED_BY_EXECUTION_RECEIPT" },
    "pending_environment_state": { "const": "REMOVED_AFTER_VERIFIED_PROMOTION" },
    "migration_execution_authorized": { "const": false },
    "technical_preview_authorized": { "const": false },
    "production_authorized": { "const": false },
    "updater_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "attribution": { "const": "Lab | zefry" }
  }
}
