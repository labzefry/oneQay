{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oneqay.installation-completion-handoff.v1",
  "title": "oneQay Installation Completion Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "completion_state",
    "release_id",
    "request_id",
    "authority_id",
    "execution_receipt_sha256",
    "post_promotion_verification_sha256",
    "active_environment_sha256",
    "completed_at_unix",
    "installer_reentry_state",
    "migration_execution_authorized",
    "technical_preview_authorized",
    "persistence_authorized",
    "production_authorized",
    "updater_authorized",
    "deployment_authorized",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "oneQay" },
    "completion_state": { "const": "INSTALLATION_CONFIGURATION_COMPLETE_NOT_ACTIVATED" },
    "release_id": { "type": "string", "pattern": "^m75-preview-[0-9a-f]{12}$" },
    "request_id": { "type": "string", "pattern": "^promotion-request-[0-9a-f]{24}$" },
    "authority_id": { "type": "string", "pattern": "^promotion-authority-[0-9a-f]{24}$" },
    "execution_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "post_promotion_verification_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "active_environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completed_at_unix": { "type": "integer", "minimum": 1 },
    "installer_reentry_state": { "const": "READ_ONLY_COMPLETION" },
    "migration_execution_authorized": { "const": false },
    "technical_preview_authorized": { "const": false },
    "persistence_authorized": { "const": false },
    "production_authorized": { "const": false },
    "updater_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "attribution": { "const": "Lab | zefry" }
  }
}
