{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oneqay.runtime-configuration-post-promotion-verification.v1",
  "title": "oneQay Runtime Configuration Post-Promotion Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "verification_state",
    "release_id",
    "request_id",
    "authority_id",
    "execution_receipt_sha256",
    "active_environment_sha256",
    "verified_at_unix",
    "pending_environment_absent",
    "runtime_configuration_active",
    "migration_execution_authorized",
    "technical_preview_authorized",
    "production_authorized",
    "updater_authorized",
    "deployment_authorized",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "oneQay" },
    "verification_state": { "const": "RUNTIME_CONFIGURATION_VERIFIED_NOT_ACTIVATED" },
    "release_id": { "type": "string", "pattern": "^m75-preview-[0-9a-f]{12}$" },
    "request_id": { "type": "string", "pattern": "^promotion-request-[0-9a-f]{24}$" },
    "authority_id": { "type": "string", "pattern": "^promotion-authority-[0-9a-f]{24}$" },
    "execution_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "active_environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verified_at_unix": { "type": "integer", "minimum": 1 },
    "pending_environment_absent": { "const": true },
    "runtime_configuration_active": { "const": true },
    "migration_execution_authorized": { "const": false },
    "technical_preview_authorized": { "const": false },
    "production_authorized": { "const": false },
    "updater_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "attribution": { "const": "Lab | zefry" }
  }
}
