{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneqay.invalid/contracts/durable-staging-deployment-authority.schema.json",
  "title": "oneQay Durable Staging Deployment Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "authority_id",
    "authority_state",
    "scope",
    "request_id",
    "request_sha256",
    "release_id",
    "source_commit",
    "artifact_sha256",
    "environment_id",
    "target_descriptor_sha256",
    "approval_token_sha256",
    "authorized_at_unix",
    "expires_at_unix",
    "deployment_allowed",
    "migration_execution_allowed",
    "production_allowed",
    "technical_preview_activation_allowed",
    "updater_activation_allowed",
    "target_selection_allowed",
    "producer_dispatch_allowed",
    "attribution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "oneQay"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^durable-staging-deployment-authority-[0-9a-f]{24}$"
    },
    "authority_state": {
      "const": "GRANTED"
    },
    "scope": {
      "const": "DEPLOY_EXACT_DURABLE_STAGING_ARTIFACT_TO_EXACT_NON_PRODUCTION_TARGET"
    },
    "request_id": {
      "type": "string",
      "pattern": "^durable-staging-deployment-request-[0-9a-f]{24}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^durable-staging-[0-9a-f]{12}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "target_descriptor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_token_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorized_at_unix": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at_unix": {
      "type": "integer",
      "minimum": 1
    },
    "deployment_allowed": {
      "const": true
    },
    "migration_execution_allowed": {
      "const": false
    },
    "production_allowed": {
      "const": false
    },
    "technical_preview_activation_allowed": {
      "const": false
    },
    "updater_activation_allowed": {
      "const": false
    },
    "target_selection_allowed": {
      "const": false
    },
    "producer_dispatch_allowed": {
      "const": false
    },
    "attribution": {
      "const": "Lab | zefry"
    }
  }
}
