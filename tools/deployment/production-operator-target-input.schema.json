{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneqay.invalid/contracts/production-operator-target-input.schema.json",
  "title": "oneQay Production Operator Target Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_class",
    "execution_channel",
    "environment_id",
    "runtime_class",
    "production",
    "production_data_allowed",
    "isolated_environment",
    "release_binding",
    "filesystem",
    "health",
    "operator_assertions",
    "attribution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_class": {
      "enum": [
        "OPERATOR_MANAGED_FILESYSTEM",
        "CPANEL_NO_SSH"
      ]
    },
    "execution_channel": {
      "enum": [
        "PHP_CLI",
        "CPANEL_CRON_PHP_CLI_NO_SSH"
      ]
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "runtime_class": {
      "const": "production"
    },
    "production": {
      "const": true
    },
    "production_data_allowed": {
      "const": true
    },
    "isolated_environment": {
      "const": true
    },
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "source_commit",
        "artifact_sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^production-[0-9a-f]{12}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_root",
        "release_root",
        "shared_runtime_root",
        "active_release_pointer",
        "document_root"
      ],
      "properties": {
        "deployment_root": {
          "type": "string",
          "minLength": 2
        },
        "release_root": {
          "type": "string",
          "minLength": 2
        },
        "shared_runtime_root": {
          "type": "string",
          "minLength": 2
        },
        "active_release_pointer": {
          "type": "string",
          "minLength": 2
        },
        "document_root": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "path"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "path": {
          "const": "/health/live"
        }
      }
    },
    "operator_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durable_database_persistence",
        "durable_session",
        "authorization",
        "transaction_durability",
        "pos_durability",
        "authenticated_configuration_channel",
        "read_before_write",
        "read_after_write",
        "non_mutating_health_attestation",
        "verified_rollback"
      ],
      "properties": {
        "durable_database_persistence": {
          "const": true
        },
        "durable_session": {
          "const": true
        },
        "authorization": {
          "const": true
        },
        "transaction_durability": {
          "const": true
        },
        "pos_durability": {
          "const": true
        },
        "authenticated_configuration_channel": {
          "const": true
        },
        "read_before_write": {
          "const": true
        },
        "read_after_write": {
          "const": true
        },
        "non_mutating_health_attestation": {
          "const": true
        },
        "verified_rollback": {
          "const": true
        }
      }
    },
    "attribution": {
      "const": "Lab | zefry"
    }
  }
}
