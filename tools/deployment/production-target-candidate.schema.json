{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneqay.invalid/contracts/production-target-candidate.schema.json",
  "title": "oneQay Production Target Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_state",
    "environment_id",
    "runtime_class",
    "production",
    "production_data_allowed",
    "isolated_environment",
    "filesystem",
    "capabilities",
    "configuration",
    "attribution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_state": {
      "const": "PRODUCTION_TARGET_CANDIDATE"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "runtime_class": {
      "const": "production"
    },
    "production": {
      "const": true
    },
    "production_data_allowed": {
      "const": true
    },
    "isolated_environment": {
      "const": true
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_root",
        "release_root",
        "shared_runtime_root",
        "active_release_pointer"
      ],
      "properties": {
        "deployment_root": {
          "type": "string"
        },
        "release_root": {
          "type": "string"
        },
        "shared_runtime_root": {
          "type": "string"
        },
        "active_release_pointer": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durable_database_persistence",
        "durable_session",
        "authorization",
        "transaction_durability",
        "pos_durability",
        "authenticated_configuration_channel",
        "read_before_write",
        "read_after_write",
        "non_mutating_health_attestation",
        "verified_rollback"
      ],
      "properties": {
        "durable_database_persistence": {
          "const": true
        },
        "durable_session": {
          "const": true
        },
        "authorization": {
          "const": true
        },
        "transaction_durability": {
          "const": true
        },
        "pos_durability": {
          "const": true
        },
        "authenticated_configuration_channel": {
          "const": true
        },
        "read_before_write": {
          "const": true
        },
        "read_after_write": {
          "const": true
        },
        "non_mutating_health_attestation": {
          "const": true
        },
        "verified_rollback": {
          "const": true
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_values_embedded",
        "required_binding_presence"
      ],
      "properties": {
        "secret_values_embedded": {
          "const": false
        },
        "required_binding_presence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ONEQAY_RUNTIME_CLASS",
            "ONEQAY_RUNNING_SOURCE_COMMIT",
            "ONEQAY_RUNNING_ARTIFACT_SHA256",
            "ONEQAY_PRODUCTION_ENVIRONMENT_ID",
            "ONEQAY_PRODUCTION_ATTESTATION_TOKEN"
          ],
          "properties": {
            "ONEQAY_RUNTIME_CLASS": {
              "const": true
            },
            "ONEQAY_RUNNING_SOURCE_COMMIT": {
              "const": true
            },
            "ONEQAY_RUNNING_ARTIFACT_SHA256": {
              "const": true
            },
            "ONEQAY_PRODUCTION_ENVIRONMENT_ID": {
              "const": true
            },
            "ONEQAY_PRODUCTION_ATTESTATION_TOKEN": {
              "const": true
            }
          }
        }
      }
    },
    "attribution": {
      "const": "Lab | zefry"
    }
  }
}
