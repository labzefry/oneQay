{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneqay.invalid/contracts/durable-staging-deployment-authority-request.schema.json",
  "title": "oneQay Durable Staging Deployment Authority Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "request_state",
    "request_id",
    "requested_scope",
    "release_id",
    "source_commit",
    "artifact_sha256",
    "manifest_sha256",
    "environment_id",
    "target_descriptor_sha256",
    "required_authority",
    "migration_execution_authorized",
    "production_authorized",
    "technical_preview_activation_authorized",
    "updater_activation_authorized",
    "target_selection_authorized",
    "producer_dispatch_authorized",
    "attribution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "oneQay"
    },
    "request_state": {
      "const": "DURABLE_STAGING_DEPLOYMENT_AUTHORITY_REQUEST_PENDING_APPROVAL"
    },
    "request_id": {
      "type": "string",
      "pattern": "^durable-staging-deployment-request-[0-9a-f]{24}$"
    },
    "requested_scope": {
      "const": "DEPLOY_EXACT_DURABLE_STAGING_ARTIFACT_TO_EXACT_NON_PRODUCTION_TARGET"
    },
    "release_id": {
      "type": "string",
      "pattern": "^durable-staging-[0-9a-f]{12}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "target_descriptor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "separate_operational_authority_required",
        "exact_request_required",
        "exact_target_descriptor_required",
        "exact_environment_required",
        "exact_release_required",
        "exact_artifact_required",
        "approval_token_required",
        "maximum_lifetime_seconds"
      ],
      "properties": {
        "state": {
          "const": "NOT_GRANTED"
        },
        "separate_operational_authority_required": {
          "const": true
        },
        "exact_request_required": {
          "const": true
        },
        "exact_target_descriptor_required": {
          "const": true
        },
        "exact_environment_required": {
          "const": true
        },
        "exact_release_required": {
          "const": true
        },
        "exact_artifact_required": {
          "const": true
        },
        "approval_token_required": {
          "const": true
        },
        "maximum_lifetime_seconds": {
          "const": 900
        }
      }
    },
    "migration_execution_authorized": {
      "const": false
    },
    "production_authorized": {
      "const": false
    },
    "technical_preview_activation_authorized": {
      "const": false
    },
    "updater_activation_authorized": {
      "const": false
    },
    "target_selection_authorized": {
      "const": false
    },
    "producer_dispatch_authorized": {
      "const": false
    },
    "attribution": {
      "const": "Lab | zefry"
    }
  }
}
