{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneqay.invalid/contracts/durable-staging-deployment-evidence.schema.json",
  "title": "oneQay Durable Staging Deployment Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "evidence_state",
    "environment_id",
    "runtime_class",
    "release_id",
    "source_commit",
    "artifact_sha256",
    "deployment_plan_fingerprint",
    "deployment_authority_id",
    "deployment_authority_sha256",
    "deployment_request_id",
    "deployment_request_sha256",
    "verification",
    "runtime_readback",
    "operational_boundary",
    "secrets_embedded",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "oneQay" },
    "evidence_state": { "const": "DEPLOYED_VERIFIED_NOT_SELECTED" },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "runtime_class": { "const": "durable-staging" },
    "release_id": {
      "type": "string",
      "pattern": "^durable-staging-[0-9a-f]{12}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deployment_plan_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deployment_authority_id": {
      "type": "string",
      "pattern": "^durable-staging-deployment-authority-[0-9a-f]{24}$"
    },
    "deployment_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deployment_request_id": {
      "type": "string",
      "pattern": "^durable-staging-deployment-request-[0-9a-f]{24}$"
    },
    "deployment_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_passed",
        "previous_active_release_preserved",
        "immutable_release_extracted",
        "public_document_root_verified",
        "external_runtime_configuration_bound",
        "provenance_readback_verified",
        "configuration_read_before_write_verified",
        "configuration_read_after_write_verified",
        "non_mutating_health_attestation_verified",
        "rollback_path_verified"
      ],
      "properties": {
        "preflight_passed": { "const": true },
        "previous_active_release_preserved": { "const": true },
        "immutable_release_extracted": { "const": true },
        "public_document_root_verified": { "const": true },
        "external_runtime_configuration_bound": { "const": true },
        "provenance_readback_verified": { "const": true },
        "configuration_read_before_write_verified": { "const": true },
        "configuration_read_after_write_verified": { "const": true },
        "non_mutating_health_attestation_verified": { "const": true },
        "rollback_path_verified": { "const": true }
      }
    },
    "runtime_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "runtime_class",
        "exact_running_source_commit",
        "exact_running_artifact_sha256",
        "durable_staging_runtime_enabled",
        "production_data_allowed"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "runtime_class": { "const": "durable-staging" },
        "exact_running_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "exact_running_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "durable_staging_runtime_enabled": { "const": true },
        "production_data_allowed": { "const": false }
      }
    },
    "operational_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration27_execution",
        "permission_provisioning",
        "feature_activation",
        "technical_preview_activation",
        "production_activation",
        "updater_activation",
        "target_selection",
        "selected_target",
        "producer_dispatch"
      ],
      "properties": {
        "migration27_execution": { "const": "NOT_PERFORMED" },
        "permission_provisioning": { "const": "NONE" },
        "feature_activation": { "const": "INACTIVE" },
        "technical_preview_activation": { "const": "NOT_AUTHORIZED" },
        "production_activation": { "const": "NOT_AUTHORIZED" },
        "updater_activation": { "const": "INACTIVE" },
        "target_selection": { "const": "NOT_PERFORMED" },
        "selected_target": { "type": "null" },
        "producer_dispatch": { "const": "NOT_PERFORMED" }
      }
    },
    "secrets_embedded": { "const": false },
    "attribution": { "const": "Lab | zefry" }
  }
}
