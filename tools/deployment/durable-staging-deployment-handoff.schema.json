{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneqay.invalid/contracts/durable-staging-deployment-handoff.schema.json",
  "title": "oneQay Durable Staging Deployment Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_state",
    "product",
    "artifact",
    "runtime",
    "migration",
    "deployment",
    "required_external_bindings",
    "operational_boundary",
    "attribution"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "handoff_state": {"type": "string", "const": "VALIDATED_FOR_EXTERNAL_DEPLOYMENT_NOT_AUTHORIZED"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository"],
      "properties": {
        "name": {"type": "string", "const": "oneQay"},
        "repository": {"type": "string", "const": "labzefry/oneQay"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "source_commit",
        "artifact_filename",
        "artifact_sha256",
        "artifact_size_bytes",
        "manifest_sha256"
      ],
      "properties": {
        "release_id": {"type": "string", "pattern": "^durable-staging-[0-9a-f]{12}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_filename": {"type": "string", "pattern": "^durable-staging-[0-9a-f]{12}\\.tar\\.gz$"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_channel",
        "release_environment",
        "required_runtime_class",
        "production",
        "production_data_allowed",
        "synthetic_fixture_runtime",
        "environment_values_embedded"
      ],
      "properties": {
        "release_channel": {"type": "string", "const": "STAGING"},
        "release_environment": {"type": "string", "const": "DURABLE_STAGING"},
        "required_runtime_class": {"type": "string", "const": "durable-staging"},
        "production": {"type": "boolean", "const": false},
        "production_data_allowed": {"type": "boolean", "const": false},
        "synthetic_fixture_runtime": {"type": "boolean", "const": false},
        "environment_values_embedded": {"type": "boolean", "const": false}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_included",
        "expected_count",
        "latest_migration",
        "execution_state",
        "execution_authorized"
      ],
      "properties": {
        "source_included": {"type": "boolean", "const": true},
        "expected_count": {"type": "integer", "const": 27},
        "latest_migration": {"type": "string", "const": "0000_00_00_000027_create_pos_shift_close_evidence_foundation.php"},
        "execution_state": {"type": "string", "const": "NOT_PERFORMED"},
        "execution_authorized": {"type": "boolean", "const": false}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_state",
        "archive_extraction_state",
        "runtime_configuration_mutation_state",
        "active_release_pointer_mutation_state",
        "authority_state"
      ],
      "properties": {
        "execution_state": {"type": "string", "const": "NOT_PERFORMED"},
        "archive_extraction_state": {"type": "string", "const": "NOT_PERFORMED"},
        "runtime_configuration_mutation_state": {"type": "string", "const": "NOT_PERFORMED"},
        "active_release_pointer_mutation_state": {"type": "string", "const": "NOT_PERFORMED"},
        "authority_state": {"type": "string", "const": "NOT_GRANTED"}
      }
    },
    "required_external_bindings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ONEQAY_RUNTIME_CLASS",
          "ONEQAY_RUNNING_SOURCE_COMMIT",
          "ONEQAY_RUNNING_ARTIFACT_SHA256",
          "ONEQAY_DURABLE_RUNTIME_ENVIRONMENT_ID",
          "ONEQAY_DURABLE_RUNTIME_ATTESTATION_TOKEN",
          "ONEQAY_DURABLE_STAGING_RUNTIME_ENABLED"
        ]
      }
    },
    "operational_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_creation",
        "environment_deployment",
        "migration27_execution",
        "permission_provisioning",
        "feature_activation",
        "technical_preview_activation",
        "production_activation",
        "updater_activation",
        "target_selection",
        "selected_target",
        "producer_dispatch"
      ],
      "properties": {
        "environment_creation": {"type": "string", "const": "NOT_PERFORMED"},
        "environment_deployment": {"type": "string", "const": "NOT_PERFORMED"},
        "migration27_execution": {"type": "string", "const": "NOT_PERFORMED"},
        "permission_provisioning": {"type": "string", "const": "NONE"},
        "feature_activation": {"type": "string", "const": "INACTIVE"},
        "technical_preview_activation": {"type": "string", "const": "NOT_AUTHORIZED"},
        "production_activation": {"type": "string", "const": "NOT_AUTHORIZED"},
        "updater_activation": {"type": "string", "const": "INACTIVE"},
        "target_selection": {"type": "string", "const": "BLOCKED_NO_QUALIFIED_NON_SYNTHETIC_DURABLE_TARGET"},
        "selected_target": {"type": "null"},
        "producer_dispatch": {"type": "string", "const": "NOT_PERFORMED"}
      }
    },
    "attribution": {"type": "string", "const": "Lab | zefry"}
  }
}
